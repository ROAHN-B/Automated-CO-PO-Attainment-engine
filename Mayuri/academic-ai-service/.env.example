# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Seconds to wait for one Gemini call before failing with 504 UPSTREAM_TIMEOUT.
LLM_TIMEOUT_SECONDS=60
# Shared secret Spring Boot sends in the X-Internal-Token header. Leave empty only for local development.
INTERNAL_API_TOKEN=
